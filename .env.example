# ===== LLM 后端（语义独立性判断）=====
# 默认使用阿里云百炼 DashScope 的 OpenAI 兼容端点。
# 换供应商只需改这三个环境变量，无需改代码。
# 例：DeepSeek -> LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# LLM_API_KEY 优先读取；未设置时回退到 DASHSCOPE_API_KEY
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 阿里云百炼 key：https://bailian.console.aliyun.com -> API-KEY
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 已弃用 =====
# 原 HuggingFace InferenceClient 在部分网络（含国内）不可达，已替换为上面的 OpenAI 兼容端点。
# 去 https://huggingface.co/settings/tokens 新建 Read token，粘贴到下面
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
